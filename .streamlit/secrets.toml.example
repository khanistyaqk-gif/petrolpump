# Local: is file ko ".streamlit/secrets.toml" naam se copy karein.
# Streamlit Cloud: App > Settings > Secrets mein yahi paste karein.
# Supabase > Project Settings > API se values lein.

SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY = "anon-key"              # sirf login ke liye
SUPABASE_SERVICE_KEY = "service-role-key"   # SECRET. Kabhi share/commit na karein.
APP_SESSION_SECRET = "kam-se-kam-32-random-characters-yahan"
# LOGIN_DOMAIN = "pump.local"               # optional: 'ramesh' -> ramesh@pump.local
PUMP_NAME = "Aapke Pump ka Naam"          # optional: print report ke upar
PUMP_ADDRESS = "Pata, Shahar"              # optional
